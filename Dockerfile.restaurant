FROM golang:1.27-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/restaurant-mock ./cmd/restaurant-mock

FROM alpine:3.21
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /bin/restaurant-mock /app/restaurant-mock
EXPOSE 8081
ENTRYPOINT ["/app/restaurant-mock"]